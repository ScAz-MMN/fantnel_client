<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <RootNamespace>FantnelLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
  </ItemGroup>

  <!-- Copy the Fantnel runtime resources (st.sh + back\ + web\) into the output so
       the launcher is self-contained: it runs st.sh from its own directory. -->
  <Target Name="CopyFantnelResources" AfterTargets="Build">
    <ItemGroup>
      <_FantnelResources Include="$(MSBuildProjectDirectory)\..\st.sh" />
      <_FantnelBack Include="$(MSBuildProjectDirectory)\..\back\**\*" />
      <_FantnelWeb Include="$(MSBuildProjectDirectory)\..\web\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FantnelResources)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FantnelBack)" DestinationFiles="@(_FantnelBack->'$(OutDir)back\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FantnelWeb)" DestinationFiles="@(_FantnelWeb->'$(OutDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>