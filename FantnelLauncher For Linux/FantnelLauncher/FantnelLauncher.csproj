<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Copy the Fantnel runtime resources (st.bat + back\ + web\) into the output so
       the launcher is self-contained: it runs st.bat from its own directory. -->
  <Target Name="CopyFantnelResources" AfterTargets="Build">
    <ItemGroup>
      <_FantnelResources Include="$(MSBuildProjectDirectory)\..\st.bat" />
      <_FantnelBack Include="$(MSBuildProjectDirectory)\..\back\**\*" />
      <_FantnelWeb Include="$(MSBuildProjectDirectory)\..\web\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FantnelResources)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FantnelBack)" DestinationFiles="@(_FantnelBack->'$(OutDir)back\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_FantnelWeb)" DestinationFiles="@(_FantnelWeb->'$(OutDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
